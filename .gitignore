# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Runtime data — adcontrol_scan.py writes each run's pickled ObjectStore +
# log + metadata to its own loot/<run_id>/ dir. Real domain data, never meant
# to be committed. (adcontrol_sessions/ is the old pre-split location.)
loot/
adcontrol_sessions/
*.pkl

# Exported reports — includes adcontrol_<DOMAIN>_<timestamp>.html written by
# --offline (the actual naming convention `--report` writes, not just files
# literally suffixed ".report.html")
*.report.html
adcontrol_*.html
reports/

# BloodHound/SharpHound zip collections imported via --bloodhound — real
# domain data, never meant to be committed
*.zip

# Real certipy-ad scan output, kept locally for comparing against adcontrol's
# own ESC detection — real domain data (CA names, template ACLs, SIDs)
*_Certipy.txt
*_Certipy.json

# Editor / OS
.vscode/
.idea/
.DS_Store
